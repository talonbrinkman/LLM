{
  "model": {
    "vocab_size": 4096,
    "max_seq_len": 256,
    "d_model": 256,
    "n_heads": 8,
    "n_layers": 6,
    "d_ff": 1024,
    "dropout": 0.1,
    "bias": false,
    "tie_weights": true
  },
  "training": {
    "batch_size": 16,
    "learning_rate": 0.0003,
    "min_lr": 0.00003,
    "weight_decay": 0.01,
    "warmup_steps": 50,
    "max_epochs": 20,
    "grad_clip": 1.0,
    "val_split": 0.1,
    "eval_interval": 1,
    "checkpoint_dir": "model_weights",
    "device": "auto"
  }
}
